import os
# Suppress ONNX Runtime device discovery warnings
os.environ["ORT_LOGGING_LEVEL"] = "3"

import cv2
from ultralytics import YOLO

# 1. Initialize the YOLO model with the explicit task
model = YOLO("/home/pi/Downloads/onnxModel.onnx", task="detect")

# 2. Open a connection to your webcam (0 is usually the default built-in or USB webcam)
cap = cv2.VideoCapture(0)

# Set webcam resolution properties to match your model's optimized size (speeds up processing)
cap.set(cv2.CAP_PROP_FRAME_WIDTH, 320)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 320)

print("Starting live feed. Press 'q' in the video window to exit.")

while cap.isOpened():
    success, frame = cap.read()
    if not success:
        print("Error: Blurry frame or webcam disconnected.")
        break

    # 3. Run inference on the current frame
    # stream=True optimizes RAM usage; verbose=False speeds up performance
    results = model.predict(
        source=frame,
        imgsz=320,
        conf=0.4,
        stream=True,
        verbose=False
    )

    # 4. Extract and display the annotated frame
    for r in results:
        # .plot() draws the bounding boxes and labels onto the image matrix
        annotated_frame = r.plot()
        
        # Show the live feed in a desktop window
        cv2.imshow("YOLOv8 ONNX Live Feed", annotated_frame)

    # 5. Break the loop cleanly if the user presses the 'q' key
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

# Clean up system resources when finished
cap.release()
cv2.destroyAllWindows()
print("Live feed stopped.")
